{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy combined SRS study configuration (runtime composition)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "default_profile",
    "profiles",
    "profile_rules",
    "source_rules",
    "decks"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "default_profile": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "settings",
          "reviews_per_day"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "imported_preset": {
            "type": "string"
          },
          "settings": {
            "allOf": [
              {
                "$ref": "data.schema.json#/$defs/SchedulerOptions"
              },
              {
                "required": [
                  "weights",
                  "parameter_policy",
                  "learning_steps",
                  "relearning_steps"
                ]
              }
            ]
          },
          "reviews_per_day": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "profile_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "profile",
          "filter"
        ],
        "properties": {
          "profile": {
            "type": "string"
          },
          "filter": {
            "$ref": "#/$defs/Filter"
          }
        }
      }
    },
    "decks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "filter"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "filter": {
            "$ref": "#/$defs/Filter"
          }
        }
      }
    },
    "source_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "sources",
          "fields",
          "templates",
          "profile"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "recursive": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "block"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "anki": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "transform": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "missing_source": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "anki",
                "source",
                "transform"
              ]
            }
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "profile": {
            "type": "string"
          },
          "filenames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_property": {
            "type": "string"
          },
          "required_any_property": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prepare": {
            "type": "string"
          },
          "filter": {
            "$ref": "#/$defs/Filter"
          }
        }
      }
    }
  },
  "$defs": {
    "Filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Filter"
          }
        },
        "not": {
          "$ref": "#/$defs/Filter"
        },
        "include_children": {
          "type": "boolean"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null",
                  "array"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "exists": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "exists"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deck_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "card_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
